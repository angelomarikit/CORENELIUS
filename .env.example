# Public site and admin work without these.
# Add them to publish content and inquiries through Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin. Change this before sharing the site.
ADMIN_PASSWORD=change-me
# Used to sign the admin session cookie. Use a long random string in production.
ADMIN_SECRET=change-me-too
